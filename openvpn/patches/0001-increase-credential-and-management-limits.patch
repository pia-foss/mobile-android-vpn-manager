From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kape <noreply@kape.com>
Date: Tue, 20 Oct 2026 16:23:31 +0800
Subject: [PATCH 1/2] Increase credential and management line limits for JWT
 auth-tokens

Kape is moving to auth tokens to authorize OpenVPN connection and this
is done by passing a JWT auth-token as the password through the
management interface ("password 'Auth' <token>"). Three limits stop a
token longer than a few hundred bytes from getting through:

- the management input line buffer (1024) silently drops the line,
- OPTION_PARM_SIZE (256) rejects the parameter as too long,
- USER_PASS_LEN (128) silently truncates the password.

USER_PASS_LEN is set to 4096 unconditionally, the value upstream already
uses with ENABLE_PKCS11, so PKCS#11 does not need to be enabled for it.
---
 src/openvpn/manage.c  | 4 +++-
 src/openvpn/misc.h    | 8 +++-----
 src/openvpn/options.h | 4 ++--
 3 files changed, 8 insertions(+), 8 deletions(-)

diff --git a/src/openvpn/manage.c b/src/openvpn/manage.c
index 7c460e7..df45db5 100644
--- a/src/openvpn/manage.c
+++ b/src/openvpn/manage.c
@@ -2746,8 +2746,10 @@ man_connection_init(struct management *man)
         /*
          * Allocate helper objects for command line input and
          * command output from/to the socket.
+         * Should be kept larger than OPTION_PARM_SIZE from options.h, so a
+         * "password" command carrying a JWT auth-token fits on one line.
          */
-        man->connection.in = command_line_new(1024);
+        man->connection.in = command_line_new(4096);
         man->connection.out = buffer_list_new();
 
         /*
diff --git a/src/openvpn/misc.h b/src/openvpn/misc.h
index 76bcac3..c322aab 100644
--- a/src/openvpn/misc.h
+++ b/src/openvpn/misc.h
@@ -60,12 +60,10 @@ struct user_pass
     bool nocache;
     bool protected;
 
-/* max length of username/password */
-#ifdef ENABLE_PKCS11
+/* max length of username/password
+ * Raised from 128 so that a JWT auth-token fits as the password; 4096 is
+ * what upstream already uses when built with ENABLE_PKCS11. */
 #define USER_PASS_LEN 4096
-#else
-#define USER_PASS_LEN 128
-#endif
     /* Note that username and password are expected to be null-terminated */
     char username[USER_PASS_LEN];
     char password[USER_PASS_LEN];
diff --git a/src/openvpn/options.h b/src/openvpn/options.h
index 852144d..47edc0e 100644
--- a/src/openvpn/options.h
+++ b/src/openvpn/options.h
@@ -53,8 +53,8 @@
 /*
  * Max size of options line and parameter.
  */
-#define OPTION_PARM_SIZE 256
-#define OPTION_LINE_SIZE 256
+#define OPTION_PARM_SIZE 2048
+#define OPTION_LINE_SIZE 2048
 
 #define PING_TIMEOUT_MAX 86400 /* one day (in seconds) */
 
